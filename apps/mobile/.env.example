# Public Cloud origin. Use the exact HTTPS staging or production origin.
EXPO_PUBLIC_CLOUD_API_URL=https://cloud.staging.yourallies.io

# Exact HTTPS app return URL registered with Cloud and the mobile platform.
# Do not add a query string, fragment, credentials, or wildcard.
EXPO_PUBLIC_NATIVE_AUTH_REDIRECT_URI=https://your-registered-app-link.example/auth/return

# Temporary Expo Go completion mode. Keep redirect for normal native builds;
# enable manual_code only after Cloud callback behavior is deployed and smoked.
EXPO_PUBLIC_NATIVE_AUTH_COMPLETION_MODE=redirect
