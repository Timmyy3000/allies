{
  "expo": {
    "name": "allies",
    "slug": "mobile",
    "version": "1.0.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/53b77fc0-ec12-40c9-8990-7ed051a1c5dd"
    },
    "orientation": "portrait",
    "icon": "./assets/allies/icons/allies-app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/allies/icons/allies-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5800",
        "foregroundImage": "./assets/allies/icons/allies-adaptive-foreground.png",
        "monochromeImage": "./assets/allies/icons/allies-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.daviddll.allies"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/allies/icons/allies-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF5800",
          "image": "./assets/allies/icons/allies-app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Allow Allies to use your photos for your profile avatar."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53b77fc0-ec12-40c9-8990-7ed051a1c5dd"
      }
    }
  }
}
