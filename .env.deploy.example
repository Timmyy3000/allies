# Deployment configuration inventory for Railway staging or production.
# Put real values in the deployment secret/configuration store. Never commit them.

# Required in every deployed environment.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
ALLIES_TRUSTED_ORIGINS=
DATABASE_URL=
CACHE_URL=

# Cloud auth signing and digest secrets.
ALLIES_AUTH_JWT_KEY=
ALLIES_AUTH_DIGEST_KEY=
ALLIES_AUTH_FAKE_PROVIDER_ENABLED=false

# Optional Google provider.
ALLIES_AUTH_GOOGLE_ENABLED=false
ALLIES_AUTH_GOOGLE_CLIENT_ID=
ALLIES_AUTH_GOOGLE_CLIENT_SECRET=
ALLIES_AUTH_GOOGLE_REDIRECT_URI=

# Railway staging only; leave unset for non-Railway production.
# ALLIES_RAILWAY_PROXY_MODE=true

# Non-Railway deployments may enable forwarding trust only with an exact proxy allowlist.
# ALLIES_TRUST_FORWARDED_PROTO=true
# ALLIES_TRUST_FORWARDED_HOST=true
# ALLIES_TRUST_FORWARDED_FOR=true
# ALLIES_TRUSTED_PROXY_IPS=203.0.113.10

# Optional private avatar storage.
ALLIES_R2_ENABLED=false
ALLIES_R2_ENDPOINT_URL=
ALLIES_R2_BUCKET=
ALLIES_R2_ACCESS_KEY_ID=
ALLIES_R2_SECRET_ACCESS_KEY=

# Optional waitlist preview.
ALLIES_WAITLIST_ENABLED=false
ALLIES_WAITLIST_CAPABILITY_KEY=
ALLIES_WAITLIST_CONSENT_VERSION=
ALLIES_WAITLIST_JOINED_RETENTION_SECONDS=
ALLIES_WAITLIST_PROVIDER_ENABLED=false
ALLIES_WAITLIST_PROVIDER=openai
ALLIES_WAITLIST_OPENAI_API_KEY=
# Required when the OpenAI waitlist provider is enabled.
ALLIES_WAITLIST_OPENAI_MODEL=
