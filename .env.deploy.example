# Deployment configuration inventory for Railway staging or production.
# Put real values in the deployment secret/configuration store. Never commit them.

# Required in every deployed environment.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
ALLIES_TRUSTED_ORIGINS=
DATABASE_URL=
CACHE_URL=

# OBS-001 stdout events. Routine successes are sampled at 5% by default;
# errors, retries, and slow events remain retained. Keep the optional sink disabled by default.
ALLIES_WIDE_EVENTS_ENABLED=true
ALLIES_WIDE_EVENTS_SUCCESS_SAMPLE_RATE=0.05
ALLIES_WIDE_EVENTS_SLOW_MS=1000
ALLIES_WIDE_EVENTS_MAX_BYTES=16384
ALLIES_WIDE_EVENTS_SINK_ENABLED=false
ALLIES_WIDE_EVENTS_MAX_QUEUE_SIZE=256

# Cloud auth signing and digest secrets.
ALLIES_AUTH_JWT_KEY=
ALLIES_AUTH_DIGEST_KEY=
ALLIES_AUTH_FAKE_PROVIDER_ENABLED=false

# Runtime wake speculation is disabled until the Foundry contract and rollout
# gates are explicitly enabled.
ALLIES_RUNTIME_INTENT_ENABLED=false
ALLIES_RUNTIME_INTENT_RATE_LIMIT=20
ALLIES_RUNTIME_INTENT_RATE_PERIOD_SECONDS=60
ALLIES_RUNTIME_INTENT_WORKSPACE_RATE_LIMIT=5
ALLIES_RUNTIME_INTENT_WORKSPACE_RATE_PERIOD_SECONDS=60
ALLIES_RUNTIME_INTENT_DEDUPE_TTL_SECONDS=600

# Optional Google provider.
ALLIES_AUTH_GOOGLE_ENABLED=false
ALLIES_AUTH_GOOGLE_CLIENT_ID=
ALLIES_AUTH_GOOGLE_CLIENT_SECRET=
ALLIES_AUTH_GOOGLE_REDIRECT_URI=
ALLIES_AUTH_GOOGLE_NATIVE_REDIRECT_URI=

# Native auth is fail-closed and disabled until deployment owners supply and
# verify exact callback, app-link, edge-trust, and shared-cache evidence.
ALLIES_AUTH_NATIVE_ENABLED=false
ALLIES_AUTH_NATIVE_REDIRECT_URIS=
ALLIES_AUTH_NATIVE_TRANSACTION_TTL_SECONDS=600
ALLIES_AUTH_NATIVE_EXCHANGE_TTL_SECONDS=60
ALLIES_AUTH_NATIVE_PROVIDER_TIMEOUT_SECONDS=15
ALLIES_AUTH_NATIVE_CLAIM_LEASE_SECONDS=30
ALLIES_AUTH_NATIVE_TERMINAL_RETENTION_SECONDS=86400
ALLIES_AUTH_NATIVE_SIGN_IN_LIMIT=10
ALLIES_AUTH_NATIVE_CALLBACK_LIMIT=10
ALLIES_AUTH_NATIVE_EXCHANGE_LIMIT=10
ALLIES_AUTH_NATIVE_REFRESH_LIMIT=20
ALLIES_AUTH_NATIVE_LOGOUT_LIMIT=30
ALLIES_AUTH_NATIVE_ONBOARDING_LIMIT=5
ALLIES_AUTH_NATIVE_RATE_LIMIT_PERIOD_SECONDS=60
ALLIES_AUTH_NATIVE_GLOBAL_LIMIT=1000

# Railway staging only; leave unset for non-Railway production.
# ALLIES_RAILWAY_PROXY_MODE=true

# Native auth in Railway mode does not require a proxy IP allowlist. Non-Railway
# deployments may enable forwarding trust only with an exact proxy allowlist.
# ALLIES_TRUST_FORWARDED_PROTO=true
# ALLIES_TRUST_FORWARDED_HOST=true
# ALLIES_TRUST_FORWARDED_FOR=true
# ALLIES_TRUSTED_PROXY_IPS=203.0.113.10

# Optional private avatar storage.
ALLIES_R2_ENABLED=false
ALLIES_R2_ENDPOINT_URL=
ALLIES_R2_BUCKET=
ALLIES_R2_ACCESS_KEY_ID=
ALLIES_R2_SECRET_ACCESS_KEY=

# Explicit shutdowns while production release verification is pending.
ALLIES_FILE_ADMISSION_ENABLED=false
ALLIES_FILE_STORAGE_ENABLED=false
ALLIES_FILE_STORAGE_ENDPOINT_URL=
ALLIES_FILE_STORAGE_BUCKET=
ALLIES_FILE_STORAGE_ACCESS_KEY_ID=
ALLIES_FILE_STORAGE_SECRET_ACCESS_KEY=
ALLIES_FILE_INSPECTION_ENABLED=false
ALLIES_FILE_INPUT_DELIVERY_ENABLED=false
ALLIES_FILE_SCANNER_HOST=
# Defaults: 10 GB/workspace, scanner port 3310, upload lease 120 seconds.

# Optional waitlist preview.
ALLIES_WAITLIST_ENABLED=false
ALLIES_WAITLIST_CAPABILITY_KEY=
ALLIES_WAITLIST_CONSENT_VERSION=
ALLIES_WAITLIST_JOINED_RETENTION_SECONDS=
ALLIES_WAITLIST_PROVIDER_ENABLED=false
ALLIES_WAITLIST_PROVIDER=openai
ALLIES_WAITLIST_OPENAI_API_KEY=
# Required when the OpenAI waitlist provider is enabled.
ALLIES_WAITLIST_OPENAI_MODEL=
