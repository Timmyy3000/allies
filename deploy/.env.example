# Public hostname (no scheme). Serve it over HTTPS in front of the proxy port.
ALLIES_DOMAIN=allies.example.com
ALLIES_HTTP_PORT=8080
POSTGRES_PASSWORD=

# --- Secrets: generate each with `openssl rand -hex 32` ---
DJANGO_SECRET_KEY=
ALLIES_AUTH_JWT_KEY=
ALLIES_AUTH_DIGEST_KEY=
ALLIES_WAITLIST_TOKEN_KEY=
# Cloud -> Foundry, Foundry -> Cloud events, Foundry -> Cloud credentials.
# Each pair must hold the same value.
ALLIES_FOUNDRY_SERVICE_TOKEN=
ALLIES_CLOUD_SERVICE_TOKEN=
ALLIES_FOUNDRY_EVENT_SERVICE_TOKEN=
ALLIES_CLOUD_EVENT_SERVICE_TOKEN=
ALLIES_CREDENTIAL_BROKER_TOKEN=
ALLIES_CLOUD_CREDENTIAL_TOKEN=
# Fernet keys for stored credentials: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ALLIES_VAULT_KEYS=
ALLIES_INTEGRATIONS_VAULT_KEY=

# --- Sign-in (Google). Create an OAuth client and add these redirect URIs:
#   https://$ALLIES_DOMAIN/api/v1/auths/callback/google
#   https://$ALLIES_DOMAIN/api/v1/integrations/gmail/callback
ALLIES_AUTH_GOOGLE_ENABLED=true
ALLIES_AUTH_GOOGLE_CLIENT_ID=
ALLIES_AUTH_GOOGLE_CLIENT_SECRET=
# Sign-ups stay invite-only; these verified emails (or @domain) may sign up directly.
ALLIES_BETA_INVITES_REQUIRED=true
ALLIES_SIGNUP_ALLOWED_EMAILS=you@example.com

# --- Models ---
# Allies' runtime model (OpenAI-compatible endpoint; OpenRouter by default).
PROFILE_PROVISIONING_BASE_URL=https://openrouter.ai/api/v1
PROFILE_PROVISIONING_MODEL=openai/gpt-6-luna
PROFILE_PROVISIONING_API_KEY=
# Onboarding greetings use the OpenAI Responses API.
ALLIES_WAITLIST_PROVIDER_ENABLED=true
ALLIES_WAITLIST_PROVIDER=openai
ALLIES_WAITLIST_OPENAI_MODEL=gpt-5.6-luna
ALLIES_WAITLIST_OPENAI_API_KEY=
ALLIES_OPENAI_API_KEY=

# --- Runtime images and size per workspace ---
HERMES_IMAGE=ghcr.io/alliesai/allies-hermes@sha256:...
RUNTIME_IMAGE=ghcr.io/alliesai/allies-runtime@sha256:...
WORKSPACE_CPUS=2
WORKSPACE_MEMORY_MB=2048
WORKSPACE_VOLUME_SIZE_GB=3

# --- Optional ---
# S3-compatible storage for avatars and files (e.g. Cloudflare R2).
ALLIES_R2_ENABLED=false
ALLIES_R2_BUCKET=
ALLIES_R2_ENDPOINT_URL=
ALLIES_R2_ACCESS_KEY_ID=
ALLIES_R2_SECRET_ACCESS_KEY=
ALLIES_FILE_ADMISSION_ENABLED=false
ALLIES_FILE_INSPECTION_ENABLED=false
ALLIES_FILE_STORAGE_ENABLED=false
ALLIES_FILE_STORAGE_CAPACITY_BYTES=10737418240
ALLIES_FILE_STORAGE_BUCKET=
ALLIES_FILE_STORAGE_ENDPOINT_URL=
ALLIES_FILE_STORAGE_ACCESS_KEY_ID=
ALLIES_FILE_STORAGE_SECRET_ACCESS_KEY=
# Web push (generate VAPID keys with `npx web-push generate-vapid-keys`).
ALLIES_PUSH_ENABLED=false
ALLIES_PUSH_VAPID_PUBLIC_KEY=
ALLIES_PUSH_VAPID_PRIVATE_KEY=
# PostHog analytics for the web app (build time).
POSTHOG_HOST=
POSTHOG_PROJECT_TOKEN=
