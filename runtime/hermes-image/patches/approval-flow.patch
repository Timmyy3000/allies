+    async def _handle_session_approval(self, request: "web.Request") -> "web.Response":
+        """POST /api/sessions/{id}/approval — resolve one rich approval."""
+
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        session_key, key_err = self._parse_session_key_header(request)
+        if key_err:
+            return key_err
+        scope_err = self._session_approval_scope_error(request, session_key)
+        if scope_err:
+            return scope_err
+        body, body_err = await self._read_json_body(request)
+        if body_err:
+            return body_err
+        if set(body) != {"run_id", "hermes_approval_id", "decision", "deadline_at"}:
+            return web.json_response(
+                _openai_error("Invalid Hermes approval decision", code="invalid_approval_decision"),
+                status=400,
+            )
+        run_id = body.get("run_id")
+        approval_id = body.get("hermes_approval_id")
+        decision = body.get("decision")
+        deadline_at = body.get("deadline_at")
+        if (
+            not self._valid_approval_run_id(run_id)
+            or not isinstance(approval_id, str)
+            or not approval_id
+            or len(approval_id) > 128
+            or any(ord(character) < 0x20 or ord(character) == 0x7F for character in approval_id)
+            or decision not in {"approve", "reject"}
+            or not self._valid_approval_deadline(deadline_at)
+        ):
+            return web.json_response(
+                _openai_error("Invalid Hermes approval decision", code="invalid_approval_decision"),
+                status=400,
+            )
+        try:
+            from tools.approval import resolve_hermes_gateway_approval
+
+            result = resolve_hermes_gateway_approval(
+                _api_request_profile.get() or "",
