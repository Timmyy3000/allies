+        "profile_id": record["profile_id"],
+        "session_id": record["session_id"],
+        "run_id": record["run_id"],
+        "hermes_approval_id": record["hermes_approval_id"],
+        "status": record["status"],
+        "outcome": record.get("outcome"),
+        "expires_at": record["expires_at"],
+    }
