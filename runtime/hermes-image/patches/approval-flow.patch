+            "access_token",
+            "refresh_token",
+            "id_token",
+            "token",
+            "api_key",
+            "apikey",
+            "client_secret",
+            "password",
+            "passwd",
+            "auth",
+            "jwt",
+            "session",
+            "secret",
+            "key",
+            "code",
+            "signature",
+            "sig",
+            "nonce",
+            "state",
+            "x_amz_signature",
+        }
+    )
+    safe_query_keys = frozenset(
