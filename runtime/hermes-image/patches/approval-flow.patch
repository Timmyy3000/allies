+            "workspace",
+            "recipient",
+            "project",
+            "document",
+            "file",
+            "folder",
+            "page",
+            "view",
+            "ref",
+            "id",
+            "name",
+            "target",
+            "channel",
+            "org",
+            "organization",
+            "tenant",
+        }
+    )
+    safe_fragment_keys = frozenset({"section", "anchor", "page", "view", "tab", "ref"})
+    unsafe = object()
+
+    def _normalized_key(value: str) -> str:
+        return unquote_plus(value).strip().lower().replace("-", "_")
+
+    def _sanitize_query(query: str) -> str | None:
+        if not query:
+            return ""
+        sanitized = []
+        for pair in query.split("&"):
