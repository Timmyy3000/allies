+# Rich session approval receipts are deliberately process-local.  Foundry
+# addresses the live Hermes turn and only needs a short reconciliation window
+# after a response is accepted; durable outcome state belongs to Foundry.
+_HERMES_APPROVAL_RETENTION_SECONDS = 30
+_HERMES_APPROVAL_MAX_RECORDS = 1024
+_hermes_approval_records: dict[str, dict] = {}
+
+
+def _prune_hermes_approval_records(now: float | None = None) -> None:
+    """Bound rich approval receipt memory without evicting pending waits."""
+
+    now = time.time() if now is None else now
+    for approval_id, record in list(_hermes_approval_records.items()):
+        terminal_at = record.get("terminal_at")
+        if terminal_at is not None and now - terminal_at > _HERMES_APPROVAL_RETENTION_SECONDS:
+            _hermes_approval_records.pop(approval_id, None)
+        elif terminal_at is None and now - record.get("expires_at_epoch", now) > _HERMES_APPROVAL_RETENTION_SECONDS:
+            # A crashed worker cannot run the normal waiter cleanup.  Drop
+            # abandoned pending records after the same bounded reconciliation
+            # window, while live pending records remain pinned in memory.
+            _hermes_approval_records.pop(approval_id, None)
+
+
+def _mark_hermes_entry_terminal(entry, status: str, *, outcome: str | None = None) -> None:
+    """Mark a rich approval terminal and wake its blocked agent thread."""
+
+    approval_id = entry.data.get("hermes_approval_id") if entry is not None else None
+    if not isinstance(approval_id, str):
+        return
+    record = _hermes_approval_records.get(approval_id)
+    if record is None:
+        return
+    current_status = record.get("status")
+    if current_status == "pending":
+        record["status"] = status
+        record["outcome"] = outcome
+        record["terminal_at"] = time.time()
+    # A disconnect can race a just-accepted HTTP decision.  Preserve the
+    # already-resolved receipt and wake the waiter with that same outcome.
+    if record.get("status") == "resolved" and record.get("outcome") == "approved":
+        entry.result = "once"
+    else:
+        entry.result = "deny"
+    entry.event.set()
+
+
