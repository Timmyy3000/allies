+                run_id,
+                session_key,
+                approval_id,
+                decision,
+                deadline_at=deadline_at,
+            )
+        except Exception:
+            logger.exception("[api_server] Hermes approval resolution failed")
+            return web.json_response(
+                _openai_error("Hermes approval resolution failed", err_type="server_error"),
+                status=500,
+            )
+        result_status = result.get("status") if isinstance(result, dict) else None
+        if result_status == "invalid":
+            return web.json_response(
+                _openai_error("Invalid Hermes approval deadline", code="invalid_deadline"),
+                status=400,
+            )
+        if result_status == "not_found":
+            return web.json_response(
+                _openai_error("Hermes approval was not found", code="approval_not_found"),
+                status=404,
+            )
+        if result_status == "conflict":
+            return web.json_response(
+                _openai_error("Hermes approval already has another decision", code="approval_conflict"),
+                status=409,
+            )
+        if result_status in {"expired", "cancelled"}:
+            # Expiry and disconnect are terminal receipts, not resolver
+            # conflicts.  The worker can consume this receipt alongside the
+            # terminal ``approval.responded`` SSE outcome without replaying a
+            # decision against a request that is already closed.
+            return web.json_response(result, status=200)
+        if result_status not in {"accepted", "resolved"}:
+            return web.json_response(
+                _openai_error("Hermes approval could not be resolved", code="approval_not_pending"),
+                status=409,
+            )
+        return web.json_response(result, status=202 if result_status == "accepted" else 200)
