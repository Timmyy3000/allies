+def _safe_hermes_plugin_preview(command: str) -> str | None:
+    """Redact URL credentials while retaining material plugin destinations.
+
+    ``redact_sensitive_text`` handles the common credential names and URL
+    userinfo.  Plugin links also carry opaque invite values under arbitrary
+    names, so this second, structured pass preserves ordinary destination
+    fields while masking values that look like credentials.  Ambiguous opaque
+    path segments on invite/connection links fail closed; ordinary document
+    paths remain visible for a useful approval decision.
+    """
+
+    try:
+        from urllib.parse import unquote_plus, urlsplit, urlunsplit
+
+        payload = json.loads(command)
+    except Exception:
+        return None
+    if not isinstance(payload, dict) or not isinstance(payload.get("tool"), str):
+        return None
+    link_key = re.compile(
+        r"(?:url|uri|link|invite|connection|callback|redirect)", re.IGNORECASE
+    )
+    secret_query_keys = frozenset(
