+_ALLIES_ROUTINE_ACTIONS = {"create", "list", "inspect", "update", "pause", "resume", "request_delete", "delete"}
+_ALLIES_ACTIVITY_SUBJECT_CHARS = 80
+
+
+def _allies_activity_host(value: Any) -> Optional[str]:
+    if not isinstance(value, str) or not value.strip():
+        return None
+    from urllib.parse import urlsplit
+
+    raw = value.strip()
+    try:
+        host = urlsplit(raw if "//" in raw else "//" + raw).hostname or ""
+    except ValueError:
+        return None
+    host = host.lower().rstrip(".").removeprefix("www.")
+    return host if "." in host else None
+
+
+def _allies_activity_subject(value: Any) -> Optional[str]:
+    """Bound a user-facing detail: printable, single-line, at most 80 characters."""
+
+    if not isinstance(value, str):
+        return None
+    text = " ".join("".join(c if c.isprintable() else " " for c in value).split())
+    if len(text) > _ALLIES_ACTIVITY_SUBJECT_CHARS:
+        text = text[: _ALLIES_ACTIVITY_SUBJECT_CHARS - 1].rstrip() + "\u2026"
+    return text or None
+
+
+def _allies_activity(target: Any, arguments: Any) -> tuple[Optional[str], Optional[str]]:
+    """Name one tool call for the activity feed, with a safe detail when useful.
+
+    Only allowlisted, non-secret argument fields become details: hostnames,
+    search text, file names, skill names, and Safe input websites.
+    """
+
+    if not isinstance(target, str) or not target:
+        return None, None
+    args = arguments if isinstance(arguments, dict) else {}
+    action = args.get("action")
+    if target == "allies_routine_result":
+        return "routine_result", None
+    if target == "allies_routines":
+        return ("routine_" + action if action in _ALLIES_ROUTINE_ACTIONS else target), None
+    if target == "allies_ask_approval":
+        return "approval_request", None
+    name = _ALLIES_ACTIVITY_ACTIONS.get(target, {}).get(action, target)
+    subject: Any = None
+    if target == "browser_navigate":
+        subject = _allies_activity_host(args.get("url"))
+    elif target == "web_extract":
+        urls = args.get("urls")
+        subject = _allies_activity_host(urls[0]) if isinstance(urls, list) and len(urls) == 1 else None
+    elif target == "web_search":
+        subject = args.get("query")
+    elif target in {"read_file", "write_file", "patch"} and isinstance(args.get("path"), str):
+        subject = os.path.basename(args["path"].rstrip("/\\"))
+    elif target == "search_files":
+        subject = args.get("pattern")
+    elif target == "skill_view":
+        subject = args.get("name")
+    elif name == "safe_input_request":
+        subject = _allies_activity_host(args.get("website"))
+    return name, _allies_activity_subject(subject)
+
