     # -- Registration --------------------------------------------------------
 
+    def _index_provider_tools(self, provider: MemoryProvider) -> None:
+        """Index the provider's currently published tools for dispatch."""
+        from toolsets import _HERMES_CORE_TOOLS
+
+        core_tool_names = set(_HERMES_CORE_TOOLS)
+        try:
+            raw_schemas = provider.get_tool_schemas()
+        except Exception as e:
+            logger.warning(
+                "Memory provider '%s' get_tool_schemas() failed: %s",
+                provider.name,
+                e,
+            )
+            return
+        for raw_schema in raw_schemas:
+            schema = normalize_tool_schema(raw_schema)
+            if schema is None:
+                continue
+            tool_name = schema["name"]
+            if tool_name in core_tool_names:
+                logger.warning(
+                    "Memory provider '%s' tool '%s' shadows a reserved core "
+                    "tool name; registration ignored. Core tools always win — "
+                    "rename the provider's tool to something unique.",
+                    provider.name,
+                    tool_name,
+                )
+                continue
+            if tool_name and tool_name not in self._tool_to_provider:
+                self._tool_to_provider[tool_name] = provider
+            elif tool_name in self._tool_to_provider:
+                logger.warning(
+                    "Memory tool name conflict: '%s' already registered by %s, "
+                    "ignoring from %s",
+                    tool_name,
+                    self._tool_to_provider[tool_name].name,
+                    provider.name,
+                )
+
+    def _rebuild_tool_index(self) -> None:
+        """Re-index schemas after provider lifecycle changes."""
+        self._tool_to_provider.clear()
+        for provider in self._providers:
+            self._index_provider_tools(provider)
+
