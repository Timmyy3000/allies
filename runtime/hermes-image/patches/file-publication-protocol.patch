diff --git a/allies_file_publication_context.py b/allies_file_publication_context.py
new file mode 100644
index 0000000..e78a7a2
--- /dev/null
+++ b/allies_file_publication_context.py
@@ -0,0 +1,25 @@
+"""Private request context for the Allies file-publication tool."""
+
+from __future__ import annotations
+
+import re
+from contextvars import ContextVar, Token
+
+
+_CONTEXT = ContextVar("allies_file_publication_context", default=None)
+_NONCE = re.compile(r"^[0-9a-f]{64}$")
+
+
+def set_current_allies_file_publication_context(value: str) -> Token:
+    if not isinstance(value, str) or _NONCE.fullmatch(value) is None:
+        raise ValueError("file publication context is invalid")
+    return _CONTEXT.set(value)
+
+
+def get_current_allies_file_publication_context() -> str | None:
+    value = _CONTEXT.get()
+    return value if isinstance(value, str) and _NONCE.fullmatch(value) else None
+
+
+def reset_current_allies_file_publication_context(token: Token) -> None:
+    _CONTEXT.reset(token)
