# Local development only. Omitted settings use the application's local defaults.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLIES_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OBS-001 stdout events. Routine successes default to 5%; errors, retries, and
# slow events remain retained. The sink remains disabled until a bounded adapter is available.
ALLIES_WIDE_EVENTS_ENABLED=true
ALLIES_WIDE_EVENTS_SUCCESS_SAMPLE_RATE=0.05
ALLIES_WIDE_EVENTS_SLOW_MS=1000
ALLIES_WIDE_EVENTS_MAX_BYTES=16384
ALLIES_WIDE_EVENTS_SINK_ENABLED=false
ALLIES_WIDE_EVENTS_MAX_QUEUE_SIZE=256

# Set true only when exercising the deterministic local auth provider.
ALLIES_AUTH_FAKE_PROVIDER_ENABLED=false

# Runtime wake hints are opt-in and remain disabled by default.
ALLIES_RUNTIME_INTENT_ENABLED=false
ALLIES_RUNTIME_INTENT_RATE_LIMIT=20
ALLIES_RUNTIME_INTENT_RATE_PERIOD_SECONDS=60
ALLIES_RUNTIME_INTENT_WORKSPACE_RATE_LIMIT=5
ALLIES_RUNTIME_INTENT_WORKSPACE_RATE_PERIOD_SECONDS=60
ALLIES_RUNTIME_INTENT_DEDUPE_TTL_SECONDS=600

# Attachments default on; set an ALLIES_FILE_*_ENABLED override only to disable.
# Supply these external connection details to use real private storage/scanning.
ALLIES_FILE_STORAGE_ENDPOINT_URL=
ALLIES_FILE_STORAGE_BUCKET=
ALLIES_FILE_STORAGE_ACCESS_KEY_ID=
ALLIES_FILE_STORAGE_SECRET_ACCESS_KEY=
ALLIES_FILE_SCANNER_HOST=
# Defaults: 10 GB/workspace, scanner port 3310, upload lease 120 seconds.
