# Local-only example. Production values belong in the deployment secret store.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLIES_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLIES_TRUST_FORWARDED_PROTO=false
ALLIES_TRUST_FORWARDED_HOST=false
ALLIES_TRUST_FORWARDED_FOR=false
ALLIES_TRUSTED_PROXY_IPS=

# Generate independent random values of at least 32 bytes for production.
DJANGO_SECRET_KEY=
ALLIES_AUTH_JWT_KEY=
ALLIES_AUTH_DIGEST_KEY=

# Google remains disabled until every value is configured.
ALLIES_AUTH_GOOGLE_ENABLED=false
ALLIES_AUTH_GOOGLE_CLIENT_ID=
ALLIES_AUTH_GOOGLE_CLIENT_SECRET=
ALLIES_AUTH_GOOGLE_REDIRECT_URI=

# Fake auth is for deterministic development/tests only.
ALLIES_AUTH_FAKE_PROVIDER_ENABLED=false

# Private Cloudflare R2 remains disabled until every value is configured.
ALLIES_R2_ENABLED=false
ALLIES_R2_ENDPOINT_URL=
ALLIES_R2_BUCKET=
ALLIES_R2_ACCESS_KEY_ID=
ALLIES_R2_SECRET_ACCESS_KEY=

# Production uses PostgreSQL and a shared Redis-compatible cache.
DATABASE_URL=
CACHE_URL=
