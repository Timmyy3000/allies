# Copy to env.fly.local. The destination is ignored by Git.
# This database remains local; only Fly runtime resources use your Fly account.

DJANGO_SECRET_KEY=replace-with-a-random-local-secret-at-least-thirty-two-bytes
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,foundry
ALLIES_CLOUD_SERVICE_TOKEN=replace-with-the-same-local-service-token-used-by-cloud

# Create a short-lived org token with `fly tokens create org --org <slug>
# --expiry 168h --name "Foundry local Docker"`, then paste it here. Never
# commit this value.
FLY_API_TOKEN=
FLY_ORG=
FLY_REGION=ams
FLY_MULTI_CONTAINER_ENABLED=true
FLY_FILE_SECRETS_ENABLED=true

# Required when a remote Fly Machine must call this local Foundry instance.
# Use a temporary HTTPS tunnel URL; never use localhost here.
FOUNDRY_ORIGIN=

# Required only when invoking the Fly-backed lifecycle/proof operations.
# Use immutable image references rather than mutable tags.
RUNTIME_IMAGE=
HERMES_IMAGE=

PROFILE_PROVISIONING_PROVIDER=openai-api
PROFILE_PROVISIONING_MODEL=gpt-5.6-luna
PROFILE_PROVISIONING_BASE_URL=https://api.openai.com/v1
PROFILE_PROVISIONING_CREDENTIAL_NAME=OPENAI_API_KEY
PROFILE_PROVISIONING_CREDENTIAL_REF=file:///run/secrets/openai-api-key
# Used only by the local Fly activation command to stage the profile provider
# credential as a Fly file secret. Never commit the populated local env file.
PROFILE_PROVISIONING_API_KEY=

ALLIES_WIDE_EVENTS_ENABLED=true
ALLIES_WIDE_EVENTS_SUCCESS_SAMPLE_RATE=1
ALLIES_WIDE_EVENTS_SINK_ENABLED=false
