+_ALLIES_ROUTINE_RESULT_HEADER = "X-Allies-Routine-Result"
+_ALLIES_ROUTINE_RESULT_TOOLSET = "allies-routine-result"
+_ALLIES_ROUTINE_RESULT_SYSTEM_PROMPT = (
+    "You are executing a scheduled Allies routine. Complete the user's task. "
+    "Before ending, call allies_routine_result exactly once with the final "
+    "typed outcome, bounded report text, and references. That tool call is "
+    "the only authoritative result. If the task cannot be completed, use "
+    "outcome 'failed'. Do not end the turn without this tool call."
+)
+
+
+def _allies_routine_enabled_toolsets(
+    toolsets: list[str] | set[str], *, routine_result: bool
+) -> list[str]:
+    from toolsets import get_toolset_names
+
+    enabled: list[str] = []
+    for toolset in toolsets:
+        if toolset == _ALLIES_ROUTINE_RESULT_TOOLSET:
+            continue
+        if not routine_result and toolset in {"all", "*"}:
+            enabled.extend(
+                name
+                for name in get_toolset_names()
+                if name != _ALLIES_ROUTINE_RESULT_TOOLSET
+            )
+            continue
+        enabled.append(toolset)
+    if routine_result:
+        enabled.append(_ALLIES_ROUTINE_RESULT_TOOLSET)
+    return list(dict.fromkeys(enabled))
+
+
