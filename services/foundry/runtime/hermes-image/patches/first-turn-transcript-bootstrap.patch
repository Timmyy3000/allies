+    async def _handle_session_bootstrap(self, request: "web.Request") -> "web.Response":
+        """Persist one exact assistant greeting for a named local profile."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+
+        profile = _api_request_profile.get()
+        if (
+            not profile
+            or profile == "default"
+            or request.match_info.get("profile") != profile
+        ):
+            return web.json_response(
+                _openai_error(
+                    "Profile-scoped bootstrap is required",
+                    code="profile_scope_required",
+                ),
+                status=403,
+            )
+
+        peer = getattr(request, "remote", None)
+        if not peer:
+            transport = getattr(request, "transport", None)
+            if transport is not None:
+                peer_info = transport.get_extra_info("peername")
+                if isinstance(peer_info, (tuple, list)):
+                    peer = peer_info[0] if peer_info else None
+                elif isinstance(peer_info, str):
+                    peer = peer_info
+        try:
+            loopback = ipaddress.ip_address(peer).is_loopback
+        except (TypeError, ValueError):
+            loopback = False
+        if not loopback:
+            return web.json_response(
+                _openai_error(
+                    "Transcript bootstrap is loopback-only",
+                    code="loopback_required",
+                ),
+                status=403,
+            )
+
+        body, err = await self._read_json_body(request)
+        if err:
+            return err
+        if set(body) != {"schema_version", "kind", "message_id", "text"}:
+            return web.json_response(
+                _openai_error("Invalid transcript bootstrap", code="invalid_bootstrap"),
+                status=400,
+            )
+        if body.get("schema_version") != "v1" or body.get(
+            "kind"
+        ) != "assistant_transcript_bootstrap":
+            return web.json_response(
+                _openai_error("Invalid transcript bootstrap", code="invalid_bootstrap"),
+                status=400,
+            )
+        raw_message_id = body.get("message_id")
+        try:
+            message_id = str(uuid.UUID(raw_message_id))
+        except (TypeError, ValueError):
+            return web.json_response(
+                _openai_error("Invalid transcript bootstrap", code="invalid_bootstrap"),
+                status=400,
+            )
+        if raw_message_id != message_id:
+            return web.json_response(
+                _openai_error("Invalid transcript bootstrap", code="invalid_bootstrap"),
+                status=400,
+            )
+        text = body.get("text")
+        try:
+            text_bytes = text.encode("utf-8")
+        except (AttributeError, UnicodeError):
+            text_bytes = None
+        if not isinstance(text, str) or not text or text_bytes is None or len(text_bytes) > 16 * 1024:
+            return web.json_response(
+                _openai_error("Invalid transcript bootstrap", code="invalid_bootstrap"),
+                status=400,
+            )
+
+        session_id = request.match_info["session_id"]
+        _, err = await self._get_existing_session_or_404(session_id)
+        if err:
+            return err
+        db = await self._ensure_session_db_async()
+        if db is None:
+            return web.json_response(
+                _openai_error("Session database unavailable", code="session_db_unavailable"),
+                status=503,
+            )
+        from hermes_state import (
+            SessionBootstrapConflictError,
+            SessionBootstrapNotFoundError,
+        )
+        try:
+            result = await asyncio.to_thread(
+                db.bootstrap_assistant_message, session_id, message_id, text
+            )
+        except SessionBootstrapNotFoundError:
+            return web.json_response(
+                _openai_error("Session not found", code="session_not_found"),
+                status=404,
+            )
+        except SessionBootstrapConflictError:
+            return web.json_response(
+                _openai_error(
+                    "Transcript bootstrap conflicts with session history",
+                    code="transcript_bootstrap_conflict",
+                ),
+                status=409,
+            )
+        except ValueError:
+            return web.json_response(
+                _openai_error("Invalid transcript bootstrap", code="invalid_bootstrap"),
+                status=400,
+            )
+        return web.json_response(
+            {
+                "object": "hermes.session.bootstrap",
+                "session_id": session_id,
+                "message_id": message_id,
+                "status": result,
+            },
+            status=201 if result == "created" else 200,
+        )
+
