+    def bootstrap_assistant_message(
+        self, session_id: str, message_id: str, text: str
+    ) -> str:
+        """Insert one exact assistant greeting, or acknowledge its replay."""
+
+        if (
+            not isinstance(session_id, str)
+            or not session_id
+            or not isinstance(message_id, str)
+            or not message_id
+            or not isinstance(text, str)
+            or not text
+        ):
+            raise ValueError("bootstrap fields are invalid")
+        try:
+            if str(uuid.UUID(message_id)) != message_id:
+                raise ValueError
+            if len(text.encode("utf-8")) > 16 * 1024:
+                raise ValueError
+        except (UnicodeEncodeError, ValueError):
+            raise ValueError("bootstrap fields are invalid") from None
+
+        def _do(conn):
+            self._check_transcript_write_guards(conn, session_id, None)
+            session = conn.execute(
+                "SELECT id FROM sessions WHERE id = ?", (session_id,)
+            ).fetchone()
+            if session is None:
+                raise SessionBootstrapNotFoundError(session_id)
+            rows = conn.execute(
+                "SELECT role, content, platform_message_id "
+                "FROM messages WHERE session_id = ? ORDER BY id LIMIT 2",
+                (session_id,),
+            ).fetchall()
+            stored_content = self._encode_content(text)
+            if not rows:
+                conn.execute(
+                    "INSERT INTO messages "
+                    "(session_id, role, content, timestamp, platform_message_id, observed, active) "
+                    "VALUES (?, ?, ?, ?, ?, ?, ?)",
+                    (session_id, "assistant", stored_content, time.time(), message_id, 0, 1),
+                )
+                conn.execute(
+                    "UPDATE sessions SET message_count = message_count + 1 "
+                    "WHERE id = ?",
+                    (session_id,),
+                )
+                return "created"
+            if (
+                len(rows) == 1
+                and rows[0]["role"] == "assistant"
+                and rows[0]["content"] == stored_content
+                and rows[0]["platform_message_id"] == message_id
+            ):
+                return "duplicate"
+            raise SessionBootstrapConflictError(session_id)
+
+        return self._execute_write(
+            _do, patience_s=self._TRANSCRIPT_WRITE_PATIENCE_S
+        )
+
