# Copy this file to env.staging, then replace values with the Backend service
# variables exported from Railway staging. env.staging is ignored by Git.
# Compose overrides database, cache, browser origin, and remote product side
# effects so copied deployment credentials cannot reach Railway data by default.

DJANGO_SECRET_KEY=local-docker-secret-key-at-least-thirty-two-bytes
ALLIES_AUTH_JWT_KEY=local-docker-jwt-key-at-least-thirty-two-bytes
ALLIES_AUTH_DIGEST_KEY=local-docker-digest-key-at-least-thirty-two-bytes

ALLIES_AUTH_GOOGLE_ENABLED=false
ALLIES_AUTH_GOOGLE_CLIENT_ID=
ALLIES_AUTH_GOOGLE_CLIENT_SECRET=

# Local staging proof enables this explicitly; copied Railway values are not
# allowed to turn on speculative runtime wake by accident.
ALLIES_RUNTIME_INTENT_ENABLED=false
ALLIES_RUNTIME_INTENT_RATE_LIMIT=20
ALLIES_RUNTIME_INTENT_RATE_PERIOD_SECONDS=60
ALLIES_RUNTIME_INTENT_WORKSPACE_RATE_LIMIT=5
ALLIES_RUNTIME_INTENT_WORKSPACE_RATE_PERIOD_SECONDS=60
ALLIES_RUNTIME_INTENT_DEDUPE_TTL_SECONDS=600

# Keep false unless you intentionally want local onboarding to call the copied
# OpenAI greeting provider. Compose honors this value but defaults it to false.
ALLIES_WAITLIST_PROVIDER_ENABLED=false

# These three values are retained for non-Compose consumers. compose.yaml
# deliberately ignores them and uses local-safe defaults; use the explicit
# ALLIES_LOCAL_FOUNDRY_* shell overrides documented in the local Docker guide
# to connect Cloud to a tunneled/local Foundry for a test.
ALLIES_FOUNDRY_URL=http://host.docker.internal:8100
ALLIES_FOUNDRY_SERVICE_TOKEN=replace-with-foundry-allies-cloud-service-token
ALLIES_FOUNDRY_EXECUTION_ENABLED=false
# Use the same local-only value in Foundry's Cloud event delivery configuration.
ALLIES_FOUNDRY_EVENT_SERVICE_TOKEN=local-staging-foundry-event-token-change-me-32-bytes

ALLIES_WIDE_EVENTS_ENABLED=true
ALLIES_WIDE_EVENTS_SUCCESS_SAMPLE_RATE=1
ALLIES_WIDE_EVENTS_SINK_ENABLED=false
